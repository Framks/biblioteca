# ---------------------------------------------------------------
# Política de Markdown: só README.md (em qualquer pasta) e
# arquivos dentro de docs/ podem ser versionados.
# Verificado também no pre-commit (.githooks) e no CI (md-policy).
# ---------------------------------------------------------------
*.md
!README.md
!/docs/**/*.md

# Ambiente / segredos
.env
.env.*
!.env.example

# IDEs e SO
.idea/
*.iml
.vscode/
.DS_Store
.claude/

# Kotlin / Gradle
.gradle/
.kotlin/
build/
out/
*.class
*.log

# Frontend
node_modules/
dist/
.vite/
coverage/
